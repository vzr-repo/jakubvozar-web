---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import social from "@/config/social.json";
import { FaEnvelope, FaLinkedin } from "react-icons/fa";

const contactIndex = await getListPage("contact", "-index");
const { title, description, meta_title, image } = contactIndex.data;
const email = "vozarjak@gmail.com";
const linkedin = social.main.find((s) => s.name === "linkedin")?.link;

if (contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6 text-center">
          <!-- TODO Jakub: přepsat svým hlasem -->
          <p class="mb-8 text-lg">
            Chcete audit Power BI modelu, nebo se jen na něco zeptat? Napište
            mi.
          </p>
          <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
            <a
              class="btn btn-primary inline-flex items-center gap-2"
              href={`mailto:${email}?subject=Power%20BI%20audit`}
            >
              <FaEnvelope /> {email}
            </a>
            {
              linkedin && (
                <a
                  class="btn btn-outline-primary inline-flex items-center gap-2"
                  href={linkedin}
                  target="_blank"
                  rel="noopener"
                >
                  <FaLinkedin /> LinkedIn
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
