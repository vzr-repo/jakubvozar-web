---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Trading Backtest Dashboard"
  meta_title="Trading Backtest Dashboard | Jakub Vozar"
  description="Backtest SMA crossover strategie na EURUSD 1H datech za rok 2025."
>
  <section class="section-sm">
    <div class="container">
      <nav class="mb-4 text-sm text-light">
        <a href="/dashboardy" class="hover:text-primary">Dashboardy</a>
        <span class="mx-2">/</span>
        <span>Trading Backtest Dashboard</span>
      </nav>

      <h1 class="h2 mb-4">Trading Backtest Dashboard</h1>
      <p class="mb-8 text-light">
        Backtest SMA crossover strategie na EURUSD 1H datech za rok 2025.
      </p>

      <div class="grid gap-6 md:grid-cols-2">
        <iframe
          src="/charts/EquityCurve.html"
          style="width: 100%; height: 450px; border: 1px solid #3E3E3E; border-radius: 8px;"
        ></iframe>
        <iframe
          src="/charts/Drawdown.html"
          style="width: 100%; height: 450px; border: 1px solid #3E3E3E; border-radius: 8px;"
        ></iframe>
        <iframe
          src="/charts/Trades.html"
          style="width: 100%; height: 450px; border: 1px solid #3E3E3E; border-radius: 8px;"
        ></iframe>
        <iframe
          src="/charts/MonthlyPnL.html"
          style="width: 100%; height: 450px; border: 1px solid #3E3E3E; border-radius: 8px;"
        ></iframe>
      </div>
    </div>
  </section>
</Base>
