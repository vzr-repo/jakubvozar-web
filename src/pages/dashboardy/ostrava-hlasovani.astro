---
import ChartPlaceholder from "@/components/ChartPlaceholder.astro";
import DashboardPage from "@/partials/DashboardPage.astro";
---

<DashboardPage
  title="Hlasování zastupitelstva Ostravy"
  question="Jak hlasovalo Zastupitelstvo města Ostravy o akcích a jak hlasovaly jednotlivé kandidátní listiny?"
  description="Hlasování Zastupitelstva města Ostravy v období 2022–2026, jmenovité hlasy podle kandidátních listin."
  sources={[
    { name: "Výsledky hlasování zastupitelstva – ostrava.cz", url: "https://www.ostrava.cz" },
    { name: "Zvolení zastupitelé, volby 2022 – volby.cz", url: "https://www.volby.cz" },
  ]}
  dataFiles={["hlasovani", "hlasy", "zastupitele"]}
>
  <ChartPlaceholder slot="chart" label="Hlasování podle kandidátních listin" />

  <ul slot="facts">
    <li>Všechna hlasování zastupitelstva v období 2022–2026, jak je zveřejňuje ostrava.cz.</li>
    <li>Jmenovité hlasy: pro, proti, zdržel se, nehlasoval.</li>
    <li>Zastupitelé s kandidátní listinou a stranou podle volby.cz.</li>
    <li>Hlasování spárovaná s akcemi z rozpočtu, kde to jde.</li>
  </ul>

  <div slot="how">
    <!-- TODO Jakub: přepsat svým hlasem -->
    <p>
      Výsledky hlasování jsou na ostrava.cz jako HTML stránky po zasedáních.
      Každou noc se zkontroluje, jestli přibylo nové zasedání. Data jen
      ukazuju, nehodnotím je.
    </p>
  </div>
</DashboardPage>
